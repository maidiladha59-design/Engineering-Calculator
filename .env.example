# URL publik situs tanpa garis miring di akhir.
# Wajib diisi di Vercel, misalnya https://contoh-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AdSense (opsional). Iklan hanya tampil jika client ID diisi.
# Contoh: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=

# ID slot iklan dari dashboard AdSense (opsional).
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=

# Alamat email kontak yang ditampilkan di halaman /kontak (opsional).
NEXT_PUBLIC_CONTACT_EMAIL=
